      "import pathlib,subprocess,sys,os\nuv='/workspace/tools/uv-x86_64-unknown-linux-gnu/uv'\nvenv=pathlib.Path('/workspace/envs/klein-flash4')\nif venv.exists():raise RuntimeError('FA4 environment already exists')\nfreeze=subprocess.check_output([uv,'pip','freeze','--python',sys.executable],text=True)\nconstraints=pathlib.Path('/workspace/bench-20260917/flash4-baseline-constraints.txt');constraints.write_text(freeze)\nsubprocess.run([uv,'venv','--system-site-packages','--python',sys.executable,str(venv)],check=True)\nsubprocess.run([uv,'pip','install','--python',str(venv/'bin/python'),'--constraint',str(constraints),'--extra-index-url','https://download.pytorch.org/whl/cu128','--index-strategy','unsafe-best-match','flash-attn-4==4.0.0b31','kernels==0.12.3'],check=True)\n(venv/'freeze.txt').write_text(subprocess.check_output([uv,'pip','freeze','--python',str(venv/'bin/python')],text=True))\n"
