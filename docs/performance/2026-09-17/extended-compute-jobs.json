  {
    "name": "install-torch213-cu132",
    "argv": [
      "python3",
      "-c",
      "import pathlib,urllib.request,tarfile,io,subprocess,os,json,hashlib\nroot=pathlib.Path('/workspace/tools');root.mkdir(exist_ok=True)\nurl='https://github.com/astral-sh/uv/releases/download/0.12.15/uv-x86_64-unknown-linux-gnu.tar.gz'\nblob=urllib.request.urlopen(url,timeout=120).read()\nwith tarfile.open(fileobj=io.BytesIO(blob),mode='r:gz') as archive: archive.extractall(root,filter='data')\nuv=str(root/'uv-x86_64-unknown-linux-gnu/uv')\nenv={**os.environ,'UV_CACHE_DIR':'/workspace/uv-cache'}\nvenv='/workspace/envs/klein-torch213-cu132'\nsubprocess.run([uv,'venv','--python','python3',venv],env=env,check=True)\nsubprocess.run([uv,'pip','install','--python',venv+'/bin/python','--extra-index-url','https://download.pytorch.org/whl/cu132','--index-strategy','unsafe-best-match','-r','/workspace/bench-20260917/torch213-cu132-requirements.txt'],env=env,check=True)\nfreeze=subprocess.check_output([uv,'pip','freeze','--python',venv+'/bin/python'],env=env,text=True)\npathlib.Path(venv+'/freeze.txt').write_text(freeze)\nprint(json.dumps({'uv_version':'0.12.15','uv_archive_sha256':hashlib.sha256(blob).hexdigest(),'environment':venv}))\n"
